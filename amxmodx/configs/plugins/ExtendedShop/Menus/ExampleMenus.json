[
    {
        // Ключ меню, указывается в команде вызова "exshop_menu example-menu".
        "Key": "example-menu",

        // Заголовок меню. Если не указано, то берётся ключ.
        "Title": "Пример магазина:",

        // Название валюты, баланс которой будет выводиться под заголовком. Необязательно.
        "AccountCurrency": "GameMoney",

        // Товары 
        "Items": [
            // Можно указывать описанные в других местах товары
            "example-product-1",
            "example-product-2",

            // А можно прямо на месте описывать новые
            {
                // Ключ товара остаётся обязательным и должен быть уникальным.
                "Key": "example-product-3",

                "Currency": "GameMoney",
                "Price": 500,
                "Items": {
                    "Item": "Weapon",
                    "Name": "weapon_deagle"
                }
            }
        ]
    }
]